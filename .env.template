# ------------------------------------------------------------------------------
# 1. ENTORNO Y PUERTOS DEL SISTEMA
# ------------------------------------------------------------------------------
APP_ENV=production
APP_PORT=8080

# URL pública de acceso a la plataforma (vital para links de emails, webhooks y websockets)
# Ejemplo local: http://localhost:8080
# Ejemplo producción: https://crm.tuempresa.pe
ESPOCRM_SITE_URL=http://localhost:8080

# Nombre comercial del CRM
ESPOCRM_CONFIG_APPLICATION_NAME="Fluia CRM Perú"


# ------------------------------------------------------------------------------
# 2. BASE DE DATOS (MARIADB / MYSQL)
# ------------------------------------------------------------------------------
# Credenciales del contenedor MariaDB (fluia-espocrm-db)
MARIADB_ROOT_PASSWORD=cambiar_password_root_seguro_2026
MARIADB_DATABASE=espocrm
MARIADB_USER=espocrm_user
MARIADB_PASSWORD=cambiar_password_bd_seguro_2026

# Conexión utilizada por la aplicación EspoCRM (fluia-espocrm)
ESPOCRM_DATABASE_PLATFORM=Mysql
ESPOCRM_DATABASE_HOST=db
ESPOCRM_DATABASE_PORT=3306
ESPOCRM_DATABASE_NAME=espocrm
ESPOCRM_DATABASE_USER=espocrm_user
ESPOCRM_DATABASE_PASSWORD=cambiar_password_bd_seguro_2026


# ------------------------------------------------------------------------------
# 3. USUARIO ADMINISTRADOR INICIAL (Auto-instalación)
# ------------------------------------------------------------------------------
ESPOCRM_ADMIN_USERNAME=admin
ESPOCRM_ADMIN_PASSWORD=cambiar_admin_password_seguro_2026


# ------------------------------------------------------------------------------
# 4. USUARIO DE API REST & CLAVE ESTÁTICA (Auto-provisionamiento nativo)
# ------------------------------------------------------------------------------
# Al definir esta clave, el contenedor creará/actualizará automáticamente un usuario de API
# y le asignará el rol correspondiente con acceso completo, sin requerir clics en la UI.
ESPOCRM_API_KEY=fluia_api_key_peru_secreta_2026
ESPOCRM_API_USER_NAME="Integración ERP Perú"
ESPOCRM_API_ROLE_NAME="API Full Access"


# ------------------------------------------------------------------------------
# 5. LOCALIZACIÓN Y FORMATOS COMERCIALES PARA PERÚ
# ------------------------------------------------------------------------------
# Idioma por defecto (es_ES / es_MX)
ESPOCRM_CONFIG_LANGUAGE=es_ES

# Zona horaria de Perú (UTC-5)
ESPOCRM_CONFIG_TIME_ZONE=America/Lima

# Formato de fecha estándar en Perú: Día/Mes/Año (ej. 28/07/2026)
ESPOCRM_CONFIG_DATE_FORMAT=DD/MM/YYYY

# Formato de hora en 24 horas (ej. 17:30)
ESPOCRM_CONFIG_TIME_FORMAT=HH:mm

# Inicio de semana comercial: 1 = Lunes (estándar en Perú), 0 = Domingo
ESPOCRM_CONFIG_WEEK_START=1

# Formato numérico estándar bancario / SUNAT:
ESPOCRM_CONFIG_THOUSAND_SEPARATOR=","
ESPOCRM_CONFIG_DECIMAL_MARK="."

# Esquema Bimonetario Común en Perú:
ESPOCRM_CONFIG_DEFAULT_CURRENCY=PEN
ESPOCRM_CONFIG_BASE_CURRENCY=PEN
ESPOCRM_CONFIG_CURRENCY_LIST='["PEN","USD"]'

# Prioridad para autocompletado y formato telefónico (+51 Perú primero)
ESPOCRM_CONFIG_PHONE_NUMBER_PREFERRED_COUNTRY_LIST='["pe","us"]'


# ------------------------------------------------------------------------------
# 5. PERSONALIZACIÓN VISUAL, THEME Y BRANDING
# ------------------------------------------------------------------------------
# Tema visual base (Opciones nativas: Espo, Dark, Light, Glass, Hazyblue, Sakura, Violet)
ESPOCRM_CONFIG_THEME=Espo

# Forzar tema para todos los colaboradores (evita que los usuarios lo cambien)
ESPOCRM_CONFIG_USER_THEMES_DISABLED=false

# Disposición de la barra de navegación: 'side' (lateral moderna) o 'top' (superior)
ESPOCRM_CONFIG_THEME_PARAMS_NAVBAR=side

# Ruta al logo institucional estático (para pantalla de login)
# Debe colocarse en client/custom/img/ o montarse vía volumen
ESPOCRM_CONFIG_LOGO_SRC="client/custom/img/logo-peru.svg"

# NOTA COLOR PRIMARIO: EspoCRM no posee nativamente un parámetro en config.php
# para el color primario porque compila su paleta LESS a variables CSS (--brand-primary).
# Para sobreescribirlo, se usa client/custom/css/custom.css registrado en client.json.
# Si tienes habilitada la inyección en entrypoint.sh, define aquí tu color corporativo:
ESPOCRM_PRIMARY_COLOR="#C8102E"       # Ejemplo: Rojo bandera / institucional Perú (#C8102E) o Azul corporativo (#1E40AF)
ESPOCRM_PRIMARY_COLOR_HOVER="#A00D24" # Tono oscuro para hover/active


# ------------------------------------------------------------------------------
# 6. SERVIDOR DE CORREOS SALIENTES (SMTP - NOTIFICACIONES & FACTURACIÓN)
# ------------------------------------------------------------------------------
# Remitente visible por defecto
ESPOCRM_CONFIG_OUTBOUND_EMAIL_FROM_NAME="Ventas y Facturación Perú"
ESPOCRM_CONFIG_OUTBOUND_EMAIL_FROM_ADDRESS="notificaciones@tuempresa.pe"

# Parámetros del servidor SMTP (ej. SendGrid, Amazon SES, Google Workspace, Outlook 365)
ESPOCRM_CONFIG_SMTP_SERVER="smtp.tuproveedor.pe"
ESPOCRM_CONFIG_SMTP_PORT=587
ESPOCRM_CONFIG_SMTP_AUTH=true
ESPOCRM_CONFIG_SMTP_SECURITY=TLS
ESPOCRM_CONFIG_SMTP_USERNAME="notificaciones@tuempresa.pe"
ESPOCRM_CONFIG_SMTP_PASSWORD="tu_password_smtp_seguro"


# ------------------------------------------------------------------------------
# 7. WEBSOCKETS Y NOTIFICACIONES EN TIEMPO REAL (Opcional)
# ------------------------------------------------------------------------------
# Activar solo si se despliega el contenedor WebSocket de EspoCRM
ESPOCRM_CONFIG_USE_WEB_SOCKET=false
ESPOCRM_CONFIG_WEB_SOCKET_URL="ws://localhost:8081"
ESPOCRM_CONFIG_WEB_SOCKET_ZERO_M_Q_SUBSCRIBER_DSN="tcp://*:7777"
ESPOCRM_CONFIG_WEB_SOCKET_ZERO_M_Q_SUBMISSION_DSN="tcp://cron:7777"


# ------------------------------------------------------------------------------
# 8. SISTEMA, RENDIMIENTO Y LOGS
# ------------------------------------------------------------------------------
# Reconstruir la caché automáticamente al arrancar el contenedor
# (Útil en desarrollo cuando se montan cambios en custom/)
REBUILD_ON_BOOT=false

# Nivel de log: DEBUG, INFO, NOTICE, WARNING, ERROR, CRITICAL
ESPOCRM_CONFIG_LOGGER_LEVEL=WARNING
ESPOCRM_CONFIG_LOGGER_MAX_FILE_NUMBER=30

# Activar caché de aplicación para alto rendimiento
ESPOCRM_CONFIG_USE_CACHE=true

# Modo desarrollador (debe ser false en producción)
ESPOCRM_CONFIG_IS_DEVELOPER_MODE=false
